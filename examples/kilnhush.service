[Unit]
Description=kilnhush GPU scheduler
After=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/kilnhush/dist/cli.js agent --config /etc/kilnhush/kilnhush.yaml
# `kilnhush setup` writes this unit for you. By hand: keep the name kilnhush.service,
# which discovery skips. Env: KILNHUSH_TOKEN, KILNHUSH_TG_TOKEN, JUPYTER_TOKEN.
EnvironmentFile=/etc/kilnhush/env
Restart=on-failure
# If the agent dies without cleaning up, systemd kills its whole cgroup,
# including command services in their own process groups.
KillMode=control-group

[Install]
WantedBy=multi-user.target
